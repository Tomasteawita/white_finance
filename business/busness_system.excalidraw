    {
      "id": "AQz_wVTsdaT8uNRvPa1RX",
      "type": "text",
      "x": 2979.7788964769234,
      "y": 1013.5748891576363,
      "width": 607.4595947265625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "usHFg4V4gS2iYqj2CjTKB"
      ],
      "frameId": null,
      "index": "b31",
      "roundness": null,
      "seed": 341236221,
      "version": 221,
      "versionNonce": 441691923,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786279922963,
      "link": null,
      "locked": false,
      "text": "Si no me pregunta el precio:\n¿Te hago un breve resumen y te cuento los valroes, te parece?\n\nMencionar el precio y quedarme TOTALMENTE CALLADO",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si no me pregunta el precio:\n¿Te hago un breve resumen y te cuento los valroes, te parece?\n\nMencionar el precio y quedarme TOTALMENTE CALLADO",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
