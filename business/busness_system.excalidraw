    {
      "id": "Pa8CGdJzVcq5cwwFs-l25",
      "type": "text",
      "x": 1979.9718290590886,
      "y": 1004.1799421838678,
      "width": 478.7796630859375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
